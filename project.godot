; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Birdie and Butter Save Pompeii"
config/description="A silly co-op adventure: two cats travel back in time and drag the people of Pompeii to safety."
config/version="0.2.0"
run/main_scene="res://scenes/boot/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/ppls_studios_logo.png"

[autoload]

NetworkManager="*res://autoload/network_manager.gd"
GameState="*res://autoload/game_state.gd"
CoinSave="*res://autoload/coin_save.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="civilians"
3d_physics/layer_4="guards"
3d_physics/layer_5="interactables"

[physics]

3d/default_gravity=16.0

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2

[steam]

initialization/app_data/app_id=480
